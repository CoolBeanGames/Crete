<Window x:Class="CreteLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:CreteLauncher"
        Title="Crete Hub" Height="680" Width="1120" MinHeight="520" MinWidth="880"
        Background="#161617" Foreground="#ECECEC" FontFamily="Segoe UI" FontSize="13"
        WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <local:ThumbSelector x:Key="ThumbSel"/>
        <ControlTemplate x:Key="FlatBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#454548"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="FlatPill" TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="12,4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
        <ControlTemplate x:Key="ChromeBtnTpl" TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3D"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatBtn}"/>
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="BorderBrush" Value="#4A4A4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#ECECEC"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource ChromeBtnTpl}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A9A9AE"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatBtn}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#A9A9AE"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatPill}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#4A4A4E"/>
            <Setter Property="Foreground" Value="#A9A9AE"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1B1B1C"/>
            <Setter Property="Foreground" Value="#ECECEC"/>
            <Setter Property="BorderBrush" Value="#3D3D40"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#ECECEC"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#26435C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1B1B1C"/>
            <Setter Property="Foreground" Value="#ECECEC"/>
            <Setter Property="BorderBrush" Value="#3D3D40"/>
            <Setter Property="CaretBrush" Value="#ECECEC"/>
            <Setter Property="SelectionBrush" Value="#1E9DF0"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#1B1B1C"/>
            <Setter Property="Foreground" Value="#1E9DF0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="14"/>
        </Style>
        <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,4">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1B1B1C"/>
            <Setter Property="Foreground" Value="#ECECEC"/>
            <Setter Property="BorderBrush" Value="#3D3D40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggle}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
                                <DockPanel LastChildFill="True">
                                    <Path DockPanel.Dock="Right" Data="M0,0 L4,5 L8,0" Stroke="#A9A9AE" StrokeThickness="1.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False" PopupAnimation="None">
                                <Border Background="#1B1B1C" BorderBrush="#3D3D40" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1B1B1C"/>
            <Setter Property="Foreground" Value="#ECECEC"/>
            <Setter Property="Padding" Value="7,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1E9DF0"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#A9A9AE"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#A9A9AE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <DataTemplate x:Key="ProjectCard">
            <Border Width="252" Background="#2E2E30" CornerRadius="8" Margin="0,0,14,14" BorderBrush="#3D3D40" BorderThickness="1">
                <StackPanel>
                    <Grid Height="86">
                        <Border CornerRadius="8,8,0,0">
                            <Border.OpacityMask>
                                <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                                    <VisualBrush.Visual>
                                        <Border Width="250" Height="86" CornerRadius="8,8,0,0" Background="Black"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.OpacityMask>
                            <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource ThumbSel}"/>
                        </Border>
                        <Button Content="★" Click="Favorite_Click" Tag="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="7,1" FontSize="14" Foreground="{Binding StarBrush}" Background="#66000000" BorderThickness="0"/>
                    </Grid>
                    <StackPanel Margin="11,9,11,10">
                        <TextBlock Text="{Binding Project.Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Project.Path}" FontSize="10" Foreground="#7C7C81" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,7">
                            <Border Background="#414144" CornerRadius="4" Padding="7,1" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Project.VersionHint, TargetNullValue=?}" FontSize="10" Foreground="#CFCFD3"/>
                            </Border>
                            <Border Background="#6A4FBB" CornerRadius="3" Padding="6,1" Visibility="{Binding HasCsproj, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="C#" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding Engines}" DisplayMemberPath="Id" SelectedItem="{Binding SelectedEngine}" SelectionChanged="EnginePicker_Changed" Width="158" FontSize="11"/>
                            <Button Content="Open" Click="OpenProject_Click" Tag="{Binding}" Margin="6,0,0,0" FontSize="12" Padding="14,4"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="Thumb0">
            <Viewbox Stretch="UniformToFill">
                <Grid Width="252" Height="86">
                    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="12"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                    <Rectangle Grid.Row="0" Fill="#79B6E6"/>
                    <Rectangle Grid.Row="1" Fill="#5D9C52"/>
                    <Rectangle Grid.Row="2" Fill="#6B4A2F"/>
                    <Rectangle Width="20" Height="20" Fill="#E05B4B" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,34,0,0"/>
                    <Rectangle Width="20" Height="20" Fill="#E0A458" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="68,12,0,0"/>
                    <Rectangle Width="20" Height="20" Fill="#E0A458" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="118,34,0,0"/>
                    <Rectangle Width="20" Height="20" Fill="#E05B4B" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="163,2,0,0"/>
                    <Rectangle Width="20" Height="20" Fill="#E0A458" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="208,34,0,0"/>
                </Grid>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="Thumb1">
            <Viewbox Stretch="UniformToFill">
                <Grid Width="252" Height="86" Background="#0D1826">
                    <Rectangle Height="40" VerticalAlignment="Bottom" Fill="#12324E" Opacity="0.7"/>
                    <Rectangle Height="1" Fill="#4EC9B0" Opacity="0.8" VerticalAlignment="Top" Margin="0,50,0,0"/>
                    <Rectangle Height="1" Fill="#4EC9B0" Opacity="0.7" VerticalAlignment="Top" Margin="0,58,0,0"/>
                    <Rectangle Height="1" Fill="#4EC9B0" Opacity="0.6" VerticalAlignment="Top" Margin="0,68,0,0"/>
                    <Rectangle Height="1" Fill="#4EC9B0" Opacity="0.5" VerticalAlignment="Top" Margin="0,80,0,0"/>
                    <Rectangle Width="1" Fill="#4EC9B0" Opacity="0.35" HorizontalAlignment="Left" Margin="60,46,0,0" Height="40" VerticalAlignment="Top"/>
                    <Rectangle Width="1" Fill="#4EC9B0" Opacity="0.35" HorizontalAlignment="Left" Margin="104,46,0,0" Height="40" VerticalAlignment="Top"/>
                    <Rectangle Width="1" Fill="#4EC9B0" Opacity="0.35" HorizontalAlignment="Left" Margin="148,46,0,0" Height="40" VerticalAlignment="Top"/>
                    <Rectangle Width="1" Fill="#4EC9B0" Opacity="0.35" HorizontalAlignment="Left" Margin="192,46,0,0" Height="40" VerticalAlignment="Top"/>
                    <Rectangle Width="26" Height="26" Fill="#E0A458" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="45" CenterX="13" CenterY="13"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="Thumb2">
            <Viewbox Stretch="UniformToFill">
                <Grid Width="252" Height="86" Background="#0A0E1A">
                    <Ellipse Width="3" Height="3" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,26,0,0"/>
                    <Ellipse Width="2" Height="2" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,13,0,0"/>
                    <Ellipse Width="3" Height="3" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="200,47,0,0"/>
                    <Ellipse Width="2" Height="2" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="88,60,0,0"/>
                    <Ellipse Width="2" Height="2" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="126,39,0,0"/>
                    <Ellipse Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="180,16,0,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.35">
                                <GradientStop Color="#9FD8FF" Offset="0"/>
                                <GradientStop Color="#1E9DF0" Offset="0.6"/>
                                <GradientStop Color="#0B4D80" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="Thumb3">
            <Viewbox Stretch="UniformToFill">
                <Grid Width="252" Height="86">
                    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                    <Rectangle Grid.Row="0" Fill="#8EC9EE"/>
                    <Rectangle Grid.Row="1" Fill="#71B25E"/>
                    <Rectangle Grid.Row="1" Width="3" Fill="#3C2814" Opacity="0.6" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                    <Rectangle Grid.Row="1" Width="3" Fill="#3C2814" Opacity="0.6" HorizontalAlignment="Left" Margin="46,0,0,0"/>
                    <Rectangle Grid.Row="1" Width="3" Fill="#3C2814" Opacity="0.6" HorizontalAlignment="Left" Margin="72,0,0,0"/>
                    <Rectangle Grid.Row="1" Width="3" Fill="#3C2814" Opacity="0.6" HorizontalAlignment="Left" Margin="180,0,0,0"/>
                    <Rectangle Grid.Row="1" Width="3" Fill="#3C2814" Opacity="0.6" HorizontalAlignment="Left" Margin="206,0,0,0"/>
                    <Rectangle Grid.Row="1" Width="3" Fill="#3C2814" Opacity="0.6" HorizontalAlignment="Left" Margin="232,0,0,0"/>
                    <Polygon Fill="#A33F2E" Points="110,38 136,18 162,38 162,66 110,66" Grid.RowSpan="2"/>
                </Grid>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="Thumb4">
            <Viewbox Stretch="UniformToFill">
                <Grid Width="252" Height="86" Background="#160A24">
                    <Ellipse Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Stroke="#4DE3FF" StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#4DE3FF" BlurRadius="14" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Rectangle Height="26" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="26,0,26,18" RadiusX="4" RadiusY="4" Stroke="#FF4FD8" StrokeThickness="2">
                        <Rectangle.Effect>
                            <DropShadowEffect Color="#FF4FD8" BlurRadius="16" ShadowDepth="0"/>
                        </Rectangle.Effect>
                    </Rectangle>
                </Grid>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="Thumb5">
            <Viewbox Stretch="UniformToFill">
                <Grid Width="252" Height="86" Background="#17171C">
                    <UniformGrid Rows="3" Columns="5" Margin="28,12,28,12">
                        <Rectangle Fill="#3A3A44" Margin="2"/><Rectangle Fill="#3A3A44" Margin="2"/><Rectangle Fill="#3A3A44" Margin="2"/><Rectangle Fill="#3A3A44" Margin="2"/><Rectangle Fill="#3A3A44" Margin="2"/>
                        <Rectangle Fill="#33333D" Margin="2"/><Rectangle Fill="#33333D" Margin="2"/><Rectangle Fill="#33333D" Margin="2"/><Rectangle Fill="#33333D" Margin="2"/><Rectangle Fill="#33333D" Margin="2"/>
                        <Rectangle Fill="#3A3A44" Margin="2"/><Rectangle Fill="#3A3A44" Margin="2"/><Rectangle Fill="#3A3A44" Margin="2"/><Rectangle Fill="#3A3A44" Margin="2"/><Rectangle Fill="#3A3A44" Margin="2"/>
                    </UniformGrid>
                </Grid>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="ProjectListRow">
            <Border Background="#2E2E30" BorderBrush="#3D3D40" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                <DockPanel>
                    <Border Width="64" Height="38" CornerRadius="4" Margin="0,0,12,0" DockPanel.Dock="Left" Background="#1B1B1C">
                        <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource ThumbSel}"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="★" Click="Favorite_Click" Tag="{Binding}" FontSize="14" Foreground="{Binding StarBrush}" Background="Transparent" BorderThickness="0" Padding="7,1"/>
                        <ComboBox ItemsSource="{Binding Engines}" DisplayMemberPath="Id" SelectedItem="{Binding SelectedEngine}" SelectionChanged="EnginePicker_Changed" Width="170" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="Open" Click="OpenProject_Click" Tag="{Binding}" FontSize="12" Padding="14,4" Margin="0"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Project.Name}" FontWeight="SemiBold" FontSize="13" Margin="0,0,8,0"/>
                            <Border Background="#414144" CornerRadius="4" Padding="7,1" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Project.VersionHint, TargetNullValue=?}" FontSize="10" Foreground="#CFCFD3"/>
                            </Border>
                            <Border Background="#6A4FBB" CornerRadius="3" Padding="6,1" Visibility="{Binding HasCsproj, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="C#" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Project.Path}" FontSize="11" Foreground="#7C7C81" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="InstalledRow">
            <Border Background="#2E2E30" BorderBrush="#3D3D40" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <DockPanel>
                    <Border x:Name="Logo" Width="34" Height="34" CornerRadius="7" Background="#1E9DF0" DockPanel.Dock="Left" Margin="0,0,12,0">
                        <TextBlock x:Name="LogoLetter" Text="C" FontWeight="Bold" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Launch" Click="LaunchInstalled_Click" Tag="{Binding}"/>
                        <Button Content="Verify" Click="VerifyInstalled_Click" Tag="{Binding}" Margin="0"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="13" Margin="0,0,8,0"/>
                            <Border Background="#1E3A2E" CornerRadius="9" Padding="9,1" Margin="0,0,6,0" Visibility="{Binding Dotnet, Converter={StaticResource BoolVis}}">
                                <TextBlock Text=".NET" FontSize="10" FontWeight="Bold" Foreground="#7CC879"/>
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="#7C7C81" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Tag}"/><Run Text="  ·  "/><Run Text="{Binding ExePath}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Channel}" Value="godot">
                    <Setter TargetName="Logo" Property="Background" Value="#478CBF"/>
                    <Setter TargetName="LogoLetter" Property="Text" Value="G"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="RemoteRow">
            <Border Background="#2E2E30" BorderBrush="#3D3D40" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <DockPanel>
                    <Border x:Name="RLogo" Width="34" Height="34" CornerRadius="7" Background="#1E9DF0" DockPanel.Dock="Left" Margin="0,0,12,0">
                        <TextBlock x:Name="RLogoLetter" Text="C" FontWeight="Bold" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button DockPanel.Dock="Right" Content="Install" Click="InstallRemote_Click" Tag="{Binding}" VerticalAlignment="Center" Margin="0"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Release.Tag}" FontWeight="SemiBold" FontSize="13" Margin="0,0,8,0"/>
                            <Border Background="#24384A" CornerRadius="9" Padding="9,1">
                                <TextBlock Text="stable" FontSize="10" FontWeight="Bold" Foreground="#4DB4F5"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Details}" FontSize="11" Foreground="#7C7C81" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="godot">
                    <Setter TargetName="RLogo" Property="Background" Value="#478CBF"/>
                    <Setter TargetName="RLogoLetter" Property="Text" Value="G"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="TemplateCard">
            <Border Width="168" Background="#2E2E30" BorderBrush="{Binding SelBorder}" BorderThickness="2" CornerRadius="8" Margin="0,0,12,12">
                <StackPanel>
                    <Border Height="80" CornerRadius="6,6,0,0" Background="#1B1B1C">
                        <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource ThumbSel}"/>
                    </Border>
                    <StackPanel Margin="9,7,9,8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding Desc}" FontSize="10" Foreground="#7C7C81" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="#101012" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#1F1F20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse Width="11" Height="11" Fill="#E06C60" Margin="0,0,7,0"/>
                    <Ellipse Width="11" Height="11" Fill="#E0A458" Margin="0,0,7,0"/>
                    <Ellipse Width="11" Height="11" Fill="#7CC879"/>
                </StackPanel>
                <TextBlock Text="Crete Hub" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#A9A9AE"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="launcher" FontSize="11" Foreground="#7C7C81" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="MinButton" Style="{StaticResource ChromeBtn}" Click="MinButton_Click">—</Button>
                    <Button x:Name="MaxButton" Style="{StaticResource ChromeBtn}" Click="MaxButton_Click">▢</Button>
                    <Button x:Name="CloseButton" Style="{StaticResource ChromeBtn}" Click="CloseButton_Click">✕</Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1F1F20" BorderBrush="#101012" BorderThickness="0,0,1,0">
                    <DockPanel Margin="10,14,10,10">
                        <StackPanel DockPanel.Dock="Bottom" Margin="6,0,6,2">
                            <TextBlock x:Name="SideStatus" FontSize="11" Foreground="#A9A9AE" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="8,0,8,14">
                                <Border Width="30" Height="30" CornerRadius="7" Background="#1E9DF0">
                                    <TextBlock Text="C" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="CRETE" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="HUB" FontSize="10" Foreground="#7C7C81"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="SideNewButton" Click="GoNew_Click" Background="#1E9DF0" BorderBrush="#1E9DF0" FontWeight="SemiBold" Margin="4,0,4,12" Padding="9">+ New Project</Button>
                            <TextBlock Text="MANAGE" Foreground="#7C7C81" FontSize="10" Margin="10,0,0,4"/>
                            <Button x:Name="NavProjects" Tag="projects" Style="{StaticResource NavBtn}" Click="Nav_Click">Projects</Button>
                            <Button x:Name="NavNew" Tag="new" Style="{StaticResource NavBtn}" Click="Nav_Click">New Project</Button>
                            <Button x:Name="NavInstalls" Tag="installs" Style="{StaticResource NavBtn}" Click="Nav_Click">Installs</Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1" Background="#262627">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="20,14,20,10">
                        <TextBlock x:Name="ViewTitle" Text="Projects" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Button x:Name="SegGrid" Tag="grid" Click="ViewToggle_Click" Margin="0,0,4,0" Padding="10,6">Grid</Button>
                            <Button x:Name="SegList" Tag="list" Click="ViewToggle_Click" Margin="0,0,8,0" Padding="10,6">List</Button>
                            <TextBox x:Name="SearchBox" Width="200" Margin="0,0,8,0" TextChanged="SearchBox_TextChanged" ToolTip="Search projects"/>
                            <Button x:Name="OpenButton" Click="OpenButton_Click" Margin="0,0,8,0">Open…</Button>
                            <Button x:Name="TopNewButton" Click="GoNew_Click" Background="#1E9DF0" BorderBrush="#1E9DF0" FontWeight="SemiBold" Margin="0">New Project</Button>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel x:Name="ChipsRow" Grid.Row="1" Orientation="Horizontal" Margin="20,0,20,10">
                        <Button Tag="all" Style="{StaticResource Chip}" Click="Chip_Click">All</Button>
                        <Button Tag="fav" Style="{StaticResource Chip}" Click="Chip_Click">★ Favorites</Button>
                        <Button Tag="4x" Style="{StaticResource Chip}" Click="Chip_Click">4.x</Button>
                        <Button Tag="3x" Style="{StaticResource Chip}" Click="Chip_Click">3.x</Button>
                        <Button Tag="cs" Style="{StaticResource Chip}" Click="Chip_Click">C#</Button>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="20,0,20,10">
                        <Grid x:Name="ProjectsView">
                            <ScrollViewer x:Name="GridScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ProjectsGrid" ItemTemplate="{StaticResource ProjectCard}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <ItemsControl x:Name="ProjectsList" ItemTemplate="{StaticResource ProjectListRow}"/>
                            </ScrollViewer>
                        </Grid>
                        <Grid x:Name="NewView" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Style="{StaticResource H}">Template</TextBlock>
                                <TextBlock Style="{StaticResource Sub}">Templates set the renderer preset. Full content packs arrive with the Crete engine.</TextBlock>
                                <ListBox x:Name="TemplateList" ItemTemplate="{StaticResource TemplateCard}" Height="300" SelectionChanged="TemplateList_Changed" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <TextBlock x:Name="TemplateDesc" Style="{StaticResource Sub}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#2E2E30" BorderBrush="#3D3D40" BorderThickness="1" CornerRadius="8" Padding="16" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock x:Name="SummaryName" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,12">Godot-compatible project · standard project.godot on disk</TextBlock>
                                    <TextBlock Style="{StaticResource Lbl}">Project name</TextBlock>
                                    <TextBox x:Name="ProjectName" Text="My Crete Game" Margin="0,0,0,12"/>
                                    <TextBlock Style="{StaticResource Lbl}">Location</TextBlock>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Click="BrowseLocation_Click" Margin="6,0,0,0">…</Button>
                                        <TextBox x:Name="ProjectLocation"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Lbl}">Renderer (switchable later)</TextBlock>
                                    <Button x:Name="RendForward" Tag="forward_plus" Click="Renderer_Click" Margin="0,0,0,6" HorizontalContentAlignment="Left">Forward+ · desktop / console</Button>
                                    <Button x:Name="RendMobile" Tag="mobile" Click="Renderer_Click" Margin="0,0,0,6" HorizontalContentAlignment="Left">Mobile · efficient clustered</Button>
                                    <Button x:Name="RendCompat" Tag="gl_compatibility" Click="Renderer_Click" Margin="0,0,0,12" HorizontalContentAlignment="Left">Compatibility · OpenGL / web</Button>
                                    <TextBlock Style="{StaticResource Sub}">Scripting: C# (.NET). The solution generates on first open in a .NET engine.</TextBlock>
                                    <TextBlock Style="{StaticResource Lbl}" Margin="0,4,0,5">Engine version (target install)</TextBlock>
                                    <ComboBox x:Name="EnginePicker" DisplayMemberPath="Id" Margin="0,0,0,12"/>
                                    <Button x:Name="CreateButton" Click="CreateButton_Click" Background="#1E9DF0" BorderBrush="#1E9DF0" FontWeight="SemiBold" Padding="10" Margin="0,4,0,0">Create Project</Button>
                                    <TextBlock x:Name="CreateStatus" FontSize="11" Foreground="#A9A9AE" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ScrollViewer x:Name="InstallsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H}">Installed</TextBlock>
                                <ItemsControl x:Name="InstalledRows" ItemTemplate="{StaticResource InstalledRow}"/>
                                <TextBlock x:Name="VerifyText" FontSize="11" Foreground="#7CC879" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button x:Name="AddButton" Click="AddButton_Click" Background="Transparent" BorderBrush="#4A4A4E" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,10">＋ Add engine version</Button>
                                <Button x:Name="ImportButton" Click="ImportButton_Click" Background="Transparent" BorderBrush="#4A4A4E" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,10">＋ Import local build…</Button>
                                <Border x:Name="AddPanel" Visibility="Collapsed" Background="#1F1F20" BorderBrush="#3D3D40" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button x:Name="ChanGodot" Tag="godot" Click="Channel_Click" Margin="0,0,6,0">godot</Button>
                                            <Button x:Name="ChanCrete" Tag="crete" Click="Channel_Click" Margin="0,0,6,0">crete</Button>
                                            <Button x:Name="FlavorButton" Click="FlavorButton_Click" Margin="0,0,6,0">Standard</Button>
                                            <Button x:Name="RefreshButton" Click="RefreshButton_Click" Margin="0,0,6,0">Refresh</Button>
                                            <Button x:Name="InstallLatestButton" Click="InstallLatestRemote_Click" Background="#1E9DF0" BorderBrush="#1E9DF0" FontWeight="SemiBold" Margin="0">Install latest stable</Button>
                                        </StackPanel>
                                        <ItemsControl x:Name="RemoteRows" ItemTemplate="{StaticResource RemoteRow}"/>
                                        <ProgressBar x:Name="InstallProgress" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="InstallStatus" FontSize="11" Foreground="#A9A9AE" TextWrapping="Wrap" Margin="0,6,0,0">Pick a channel, then Refresh.</TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="#1F1F20" BorderBrush="#101012" BorderThickness="0,1,0,0">
                <DockPanel Margin="14,0">
                    <TextBlock x:Name="StatusLeft" FontSize="11" Foreground="#7C7C81" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusRight" FontSize="11" Foreground="#7C7C81" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
